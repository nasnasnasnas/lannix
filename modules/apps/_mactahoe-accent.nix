# Lilac accent for the MacTahoe GTK and Kvantum builds. `base` is the
# light-mode primary of Noctalia's "Lilac AMOLED" palette; the other shades
# stand in for MacTahoe's lighter/darker blues so contrast stays as designed.
{
  base = {
    hex = "#8A56D4";
    rgb = "138,86,212";
  };
  light = {
    hex = "#9D72DE";
    rgb = "157,114,222";
  };
  pale = {
    hex = "#C4AEEC";
    rgb = "196,174,236";
  };
  dark = {
    hex = "#7443BF";
    rgb = "116,67,191";
  };
  darker = {
    hex = "#6A3BB3";
    rgb = "106,59,179";
  };
}
