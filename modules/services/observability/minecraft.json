          "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
          "expr": "clamp_max(rate(mc_server_tick_seconds_count{instance=\"wokecraft\"}[5m]) / rate(mc_server_tick_seconds_sum{instance=\"wokecraft\"}[5m]), 20)",
          "legendFormat": "TPS",
          "refId": "A"
        }
      ],
      "title": "Server TPS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
