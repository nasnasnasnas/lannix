      "targets": [
        {
          "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
          "expr": "mc_player_list{instance=\"wokecraft\"} == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Online players",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "id": true, "instance": true, "job": true },
            "renameByName": { "name": "Player" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
